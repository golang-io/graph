{
  "GraphID": "demo_implicit_fork",
  "Kind": "graph",
  "Name": "Demo · 同一出口多线",
  "Description": "验证隐式分叉与显式合并：普通节点同一端口拖出两条线，全部执行；下游经 merge(all) 等两路到齐后执行一次，通过输入引用分别读取两路节点的输出。试跑 {\"name\":\"Ada\"}。期望 greeting=同源：Ada，left=上路:Ada，right=下路:Ada，summary=上路:Ada | 下路:Ada。serial / parallel 都应得到同一份输出。",
  "Graph": {
    "Nodes": [
      {
        "ID": "start",
        "Name": "开始",
        "Kind": "__INNER__.start"
      },
      {
        "ID": "fork",
        "Name": "同源分发",
        "Inputs": {
          "name": {
            "From": "$input",
            "Field": "name"
          },
          "Outputs": {
            "Value": [
              {
                "Key": "greeting",
                "Value": "同源：{{name}}"
              }
            ]
          }
        },
        "Kind": "template"
      },
      {
        "ID": "left",
        "Name": "上路写 left",
        "Inputs": {
          "name": {
            "From": "$input",
            "Field": "name"
          },
          "Outputs": {
            "Value": [
              {
                "Key": "left",
                "Value": "上路:{{name}}"
              }
            ]
          }
        },
        "Kind": "template"
      },
      {
        "ID": "right",
        "Name": "下路写 right",
        "Inputs": {
          "name": {
            "From": "$input",
            "Field": "name"
          },
          "Outputs": {
            "Value": [
              {
                "Key": "right",
                "Value": "下路:{{name}}"
              }
            ]
          }
        },
        "Kind": "template"
      },
      {
        "ID": "merge",
        "Name": "齐汇",
        "Inputs": {
          "Mode": {
            "Value": "all"
          }
        },
        "Kind": "__INNER__.merge"
      },
      {
        "ID": "join",
        "Name": "汇总拼接",
        "Inputs": {
          "left": {
            "From": "left",
            "Field": "left"
          },
          "right": {
            "From": "right",
            "Field": "right"
          },
          "Outputs": {
            "Value": [
              {
                "Key": "summary",
                "Value": "{{left}} | {{right}}"
              }
            ]
          }
        },
        "Kind": "template"
      },
      {
        "ID": "finish",
        "Name": "结束",
        "Inputs": {
          "greeting": {
            "From": "fork",
            "Field": "greeting"
          },
          "left": {
            "From": "left",
            "Field": "left"
          },
          "right": {
            "From": "right",
            "Field": "right"
          },
          "summary": {
            "From": "join",
            "Field": "summary"
          }
        },
        "Kind": "__INNER__.end"
      }
    ],
    "Edges": [
      {
        "ID": "e_start",
        "From": "start.Out",
        "To": "fork.In"
      },
      {
        "ID": "e2",
        "From": "fork.Out",
        "To": "left.In"
      },
      {
        "ID": "e3",
        "From": "fork.Out",
        "To": "right.In"
      },
      {
        "ID": "e4",
        "From": "left.Out",
        "To": "merge.In"
      },
      {
        "ID": "e5",
        "From": "right.Out",
        "To": "merge.In"
      },
      {
        "ID": "e_m_join",
        "From": "merge.Out",
        "To": "join.In"
      },
      {
        "ID": "e6",
        "From": "join.Out",
        "To": "finish.In"
      }
    ],
    "InputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    }
  },
  "UI": {
    "ExecutionMode": "parallel",
    "StickyNotes": [
      {
        "Color": "#8b5cf6",
        "Height": 520,
        "ID": "ann_fork",
        "Note": "「同源分发」右侧一个端口拉出两条空 when 线，两路都执行；不需要并行节点。",
        "Title": "① 同一出口拖多条线",
        "Width": 900,
        "X": 40,
        "Y": 20
      },
      {
        "Color": "#0d9488",
        "Height": 520,
        "ID": "ann_join",
        "Note": "多条入边经 merge(all) 汇合：等两路到齐后只执行一次，下游分别读取 left、right 两个节点的输出。",
        "Title": "② Merge(all) 汇聚",
        "Width": 560,
        "X": 960,
        "Y": 20
      }
    ],
    "Positions": {
      "finish": {
        "X": 1460,
        "Y": 226
      },
      "fork": {
        "X": 340,
        "Y": 226
      },
      "join": {
        "X": 1180,
        "Y": 226
      },
      "left": {
        "X": 680,
        "Y": 80
      },
      "merge": {
        "X": 960,
        "Y": 226
      },
      "right": {
        "X": 680,
        "Y": 380
      },
      "start": {
        "X": 100,
        "Y": 226
      }
    },
    "EndpointSides": {
      "finish": {
        "In": "left"
      },
      "fork": {
        "In": "left",
        "Out": "right"
      },
      "join": {
        "In": "left",
        "Out": "right"
      },
      "left": {
        "In": "left",
        "Out": "right"
      },
      "merge": {
        "In": "left",
        "Out": "right"
      },
      "right": {
        "In": "left",
        "Out": "right"
      },
      "start": {
        "Out": "right"
      }
    }
  }
}

{
  "GraphID": "demo_p1_control",
  "Kind": "graph",
  "Name": "Demo · P1 错误/等待/子流",
  "Description": "验证 stop_error 主动终止与 subgraph 调用。试跑：{\"name\":\"Ada\",\"force_fail\":1} 走 boom 主动报错终止；force_fail:0 则调用子流并正常结束。",
  "Graph": {
    "Nodes": [
      {
        "ID": "start",
        "Name": "开始",
        "Kind": "__INNER__.start"
      },
      {
        "ID": "gate",
        "Name": "是否强制失败",
        "Inputs": {
          "force_fail": {
            "From": "$input",
            "Field": "force_fail"
          },
          "Expr": {
            "Value": "force_fail >= 1"
          }
        },
        "Kind": "__INNER__.switch"
      },
      {
        "ID": "boom",
        "Name": "停止报错",
        "Inputs": {
          "name": {
            "From": "$input",
            "Field": "name"
          },
          "Message": {
            "Value": "forced fail for {{name}}"
          }
        },
        "Kind": "__INNER__.stop_error"
      },
      {
        "ID": "call",
        "Name": "调用 Echo",
        "Inputs": {
          "name": {
            "From": "$input",
            "Field": "name"
          },
          "GraphID": {
            "Value": "demo_child_echo"
          }
        },
        "Kind": "__INNER__.subgraph"
      },
      {
        "ID": "ok",
        "Name": "成功汇总",
        "Inputs": {
          "output": {
            "From": "call",
            "Field": "Output"
          },
          "Outputs": {
            "Value": [
              {
                "Key": "result",
                "Value": "\"ok\""
              },
              {
                "Key": "sub",
                "Value": "output"
              }
            ]
          }
        },
        "Kind": "code"
      },
      {
        "ID": "finish",
        "Name": "结束",
        "Inputs": {
          "result": {
            "From": "ok",
            "Field": "result"
          },
          "sub": {
            "From": "ok",
            "Field": "sub"
          }
        },
        "Kind": "__INNER__.end"
      }
    ],
    "Edges": [
      {
        "ID": "e_start",
        "From": "start.Out",
        "To": "gate.In"
      },
      {
        "ID": "e2",
        "From": "gate.Case0",
        "To": "boom.In"
      },
      {
        "ID": "e3",
        "From": "gate.Case1",
        "To": "call.In"
      },
      {
        "ID": "e7",
        "From": "call.Out",
        "To": "ok.In"
      },
      {
        "ID": "e8",
        "From": "ok.Out",
        "To": "finish.In"
      }
    ],
    "InputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "force_fail": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "force_fail"
      ]
    }
  },
  "UI": {
    "Positions": {
      "boom": {
        "X": 520,
        "Y": 40
      },
      "call": {
        "X": 520,
        "Y": 200
      },
      "finish": {
        "X": 1040,
        "Y": 200
      },
      "gate": {
        "X": 260,
        "Y": 112
      },
      "ok": {
        "X": 780,
        "Y": 200
      },
      "start": {
        "X": 20,
        "Y": 112
      }
    },
    "EndpointSides": {
      "boom": {
        "In": "left"
      },
      "call": {
        "In": "left",
        "Out": "right"
      },
      "finish": {
        "In": "left"
      },
      "gate": {
        "Case0": "right",
        "Case1": "right",
        "In": "left"
      },
      "ok": {
        "In": "left",
        "Out": "right"
      },
      "start": {
        "Out": "right"
      }
    }
  }
}

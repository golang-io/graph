# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/cmd/demo
/cmd/cmd

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
*.pprof
*.prof
coverage.*
!coverage.go
*.coverprofile
profile.cov
coverage/

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Local database and runtime data
.data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Frontend (Node / Vite / Web)
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.turbo/

# env file
.env
.env.local
.env.*.local

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db

# Documentation: only track docs/apis/
/docs/*
!/docs/apis/
